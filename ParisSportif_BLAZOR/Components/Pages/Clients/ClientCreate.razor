@page "/clients/create"
@using ParisSportif_BLAZOR.Model
@inject ParisSportif_BLAZOR.Services.ClientService ClientService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Ajouter un Client</h3>

<h2 style="color:red;">@ErrorMessage</h2>

<EditForm Model="@client" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nom</label>
        <InputText class="form-control" @bind-Value="client.Name" />
        <ValidationMessage For="@(() => client.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Mot de passe</label>
        <InputText class="form-control" @bind-Value="client.Password" />
        <ValidationMessage For="@(() => client.Password)" />
    </div>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Bloqué</label>
            <InputCheckbox class="form-check-input" @bind-Value="client.isBlocked" />
            <ValidationMessage For="@(() => client.isBlocked)" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Admin</label>
            <InputCheckbox class="form-check-input" @bind-Value="client.isAdmin" />
            <ValidationMessage For="@(() => client.isAdmin)" />
        </div>
    </div>

    <button type="submit" class="btn btn-success">
        Enregistrer
    </button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Annuler
    </button>
</EditForm>

@code {
    private Client client = new Client();
    string ErrorMessage="";

    private async Task HandleValidSubmit()
    {
        
        var result = await ClientService.AddAsync(client);

        if (result.Success)
        {
            Navigation.NavigateTo("/clients");
            Console.WriteLine("Client créé avec succès : " + result.Data?.Id);
        }
        else
        {
            ErrorMessage = result.Error ?? "Erreur inconnue.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/clients");
    }
}
