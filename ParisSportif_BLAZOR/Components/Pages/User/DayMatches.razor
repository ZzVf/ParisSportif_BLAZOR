@layout Layout.UserLayout
@page "/"

<h2 class="mb-4">Matchs du jour</h2>

<div class="row g-4">

    <!-- MATCH CARD -->
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h6 class="text-muted">Premier League</h6>

                <div class="d-flex justify-content-between align-items-center mt-3">

                    <div>
                        <img src="images/arsenal.png" width="40">
                        <div>Arsenal</div>
                    </div>

                    <div class="fw-bold fs-5">
                        20:45
                    </div>

                    <div>
                        <img src="images/liverpool.png" width="40">
                        <div>Liverpool</div>
                    </div>

                </div>

                <hr>

                <div class="d-flex justify-content-between">

                    <button class="btn btn-outline-primary btn-sm">
                        1 — 2.10
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        X — 3.40
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        2 — 2.90
                    </button>

                </div>

            </div>
        </div>
    </div>


    <!-- AUTRE MATCH -->
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h6 class="text-muted">La Liga</h6>

                <div class="d-flex justify-content-between align-items-center mt-3">

                    <div>
                        <img src="images/real.png" width="40">
                        <div>Real Madrid</div>
                    </div>

                    <div class="fw-bold fs-5">
                        21:00
                    </div>

                    <div>
                        <img src="images/barca.png" width="40">
                        <div>Barcelone</div>
                    </div>

                </div>

                <hr>

                <div class="d-flex justify-content-between">

                    <button class="btn btn-outline-primary btn-sm">
                        1 — 1.80
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        X — 3.60
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        2 — 4.10
                    </button>

                </div>

            </div>
        </div>
    </div>

</div>

@code {

}
