@page "/matches"
@page "/matcheslist"
@using ParisSportif_BLAZOR.Services
@using ParisSportif_BLAZOR.Model
@rendermode InteractiveServer
@inject MatchService MatchService
@inject ClubService ClubService
@inject NavigationManager Navigation

<div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOne">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
        <h3>Matchs</h3>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <div class="row align-items-end">

            <div class="col-md-2">

                @if(string.IsNullOrWhiteSpace(ErrorMessage)) {
                    <button class="btn btn-sm btn-success me-1" @onclick="Add">
                        Nouveau
                    </button>
                }   
            </div>

            <div class="col-md-8">
                <label class="form-label">Club recherché</label>
                <InputSelect class="form-control" @bind-Value="selectedClubId">
                    <option value="0">-- Choisir un club --</option>
                    @foreach (var club in clubs)
                    {
                        <option value="@club.Id">@club.Name</option>
                    }
                </InputSelect>
            </div>

        </div>
    </div>
    </div>
  </div>
</div>


<h2 style="color:red;">@ErrorMessage</h2>

@if(matchs == null || matchs.Count == 0)
{
    <p>Aucun match à afficher...</p>
}
else{
  
    <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Score 1</th>
        <th scope="col">Score 2</th>
        <th scope="col" @onclick="() => SortByDate()">Date & Heure</th>
        <th scope="col">Top Match</th>
        <th scope="col">Status</th>
        <th scope="col">Club 1</th>
        <th scope="col">Club 2</th>
        <th scope="col">Ligue</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>

    <tbody>
      @foreach (var m in matchs)
      {
        <tr>
          <th scope="row">@m.Id</th>
          <td>@m.Score1</td>
          <td>@m.Score2</td>
          <td>@m.MatchDateTime</td>
          <td>@(m.isTopMatch ? "Oui" : "Non")</td>
          <td>@m.matchStatus</td>
          <td>@m.Club1.Name</td>
          <td>@m.Club2.Name</td>
          <td>@m.Club1.Ligue?.Name</td>
          <td>
            <button class="btn btn-sm btn-primary me-1" @onclick="() => Edit(m.Id)">Modifier</button>
            <button class="btn btn-sm btn-danger me-1" @onclick="() => ConfirmDelete(m.Id)">Annuler</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}

@if (ShowDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Confirmation d'annulation</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Êtes-vous sûr de vouloir annuler ce match ?
                        <br />
                        <strong>Cette action est irréversible.</strong>
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Revenir en arrière
                    </button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">
                        Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
  List<Match> matchs = new List<Match>();
  List<Club> clubs = new List<Club>();
  string ErrorMessage = string.Empty;
  int selectedClubId;
  

  private void SortByDate()
  {
      matchs = matchs.OrderBy(m => m.MatchDateTime).ToList();
  }
  private void SortById()
  {
      matchs = matchs.OrderBy(m => m.Id).ToList();
  }
  protected override async Task OnInitializedAsync()
    {
        try
        {
            matchs = await MatchService.GetAllAsync();
            SortById();
            clubs = await ClubService.GetAllAsync();
            Console.WriteLine("Clubs récupérés : " + clubs.Count);
            Console.WriteLine("Matchs récupérés : " + matchs.Count);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard... " + e.Message;

        }
    }

    private async Task OnClubSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int clubId) && clubId != 0)
        {
            selectedClubId = clubId;
            matchs = await MatchService.GetByClubIdAsync(clubId);
        }
        else
        {
            selectedClubId = 0;
            matchs = await MatchService.GetAllAsync();
        }
    }

  private int? MatchIdToDelete;
    private bool ShowDeleteModal = false;

    private void ConfirmDelete(int id)
    {
        MatchIdToDelete = id;
        ShowDeleteModal = true;
    }

    private async Task DeleteConfirmed()
    {
        if (MatchIdToDelete.HasValue)
        {
            await MatchService.CancelAsync(MatchIdToDelete.Value);
            matchs = await MatchService.GetAllAsync();
        }

        ShowDeleteModal = false;
        MatchIdToDelete = null;
    }

    private void CancelDelete()
    {
        ShowDeleteModal = false;
        MatchIdToDelete = null;
    }

    private void Add()
    {
        Navigation.NavigateTo("/matches/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/matches/edit/{id}"); 
    }
}
