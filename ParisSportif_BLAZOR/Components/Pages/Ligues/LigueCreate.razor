@page "/ligues/create"
@using ParisSportif_BLAZOR.Model
@inject ParisSportif_BLAZOR.Services.LigueService LigueService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Ajouter une ligue</h3>

<h2 style="color:red;">@ErrorMessage</h2>

<EditForm Model="@ligue" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nom de la ligue</label>
        <InputText class="form-control" @bind-Value="ligue.Name" />
        <ValidationMessage For="@(() => ligue.Name)" />
    </div>

    

    <button type="submit" class="btn btn-success">
        Enregistrer
    </button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Annuler
    </button>
</EditForm>

@code {
    private Ligue ligue = new Ligue();
    string ErrorMessage="";

    private async Task HandleValidSubmit()
    {
        
        var result = await LigueService.AddAsync(ligue);

        if (result.Success)
        {
            Navigation.NavigateTo("/ligues");
            Console.WriteLine("Ligue créée avec succès : " + result.Data?.Id);
        }
        else
        {
            ErrorMessage = result.Error ?? "Erreur inconnue.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/matches");
    }
}
