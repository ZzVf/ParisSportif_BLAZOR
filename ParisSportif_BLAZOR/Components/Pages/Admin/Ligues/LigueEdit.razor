@page "/admin/ligues/edit/{id:int}"
@using ParisSportif_BLAZOR.Model
@using ParisSportif_BLAZOR.Services
@inject LigueService LigueService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Modification d'une ligue</h3>

<h2 style="color:red;">@ErrorMessage</h2>

@if (ligue == null)
{
    <p>Chargement...</p>
}
else
{
    <EditForm Model="@ligue" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nom de la ligue</label>
            <InputText class="form-control" @bind-Value="ligue.Name" />
            <ValidationMessage For="@(() => ligue.Name)" />
        </div>

       <div class="mb-3">
        <label class="form-label">Logo</label>
        <InputFile class="form-control" OnChange="HandleFileSelected" />
        @if (!string.IsNullOrEmpty(ligue.Logo))
        {
            <div class="mt-2">
                <img src="@ligue.Logo" alt="Logo" style="max-width:200px; border:1px solid #ccc; padding:5px;" />
            </div>
        }
    </div>

        <button type="submit" class="btn btn-success">
            Enregistrer
        </button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
            Annuler
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Ligue? ligue;
    string ErrorMessage = "";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            ligue = await LigueService.GetAsync(Id);    
            Console.WriteLine("Ligue récupérée : " + ligue?.Name);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard..." + e.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        var success = await LigueService.UpdateAsync(ligue!);

        if (success)
            Navigation.NavigateTo("/admin/ligues");
        else
            ErrorMessage = "Erreur lors de la modification.";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;


        // Limite de taille
        var maxSize = 10_000_000;
        await using var stream = file.OpenReadStream(maxSize);
       
        // Générer un nom unique pour éviter les collisions
        var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";

        // Chemin complet côté serveur
        var savePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "ligues", fileName);

        // Copier le fichier dans wwwroot/images
        await using var fileStream = new FileStream(savePath, FileMode.Create);
        await stream.CopyToAsync(fileStream);

        // Mettre à jour le chemin relatif pour l'affichage
        ligue.Logo = $"images\\ligues\\{fileName}";

    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/ligues");
    }
}
