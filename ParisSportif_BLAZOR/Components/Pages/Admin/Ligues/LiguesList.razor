@page "/ligues"
@page "/ligueslist"
@using ParisSportif_BLAZOR.Services
@using ParisSportif_BLAZOR.Model
@rendermode InteractiveServer
@inject NavigationManager Navigation;
@inject LigueService LigueService;

<div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOne">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
        <h3>Ligues</h3>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <div class="row align-items-end">

            <div class="col-md-3">
            @if(string.IsNullOrWhiteSpace(ErrorMessage)) {
                <button class="btn btn-success btn-lg w-100" @onclick="Add">
                    Nouveau
                </button>
            }   

            </div>
        </div>
    </div>
    </div>
  </div>
</div>

<h2 style="color:red;">@ErrorMessage</h2>

@if(ligues == null || ligues.Count == 0)
{
    <p>Aucune ligue à afficher...</p>
}
else{
    <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">Logo</th>
        <th scope="col">Actions</th> 
      </tr>
    </thead>

    <tbody>
      @foreach (var l in ligues)
      {
        <tr>
          <th scope="row">@l.Id</th>
          <td>@l.Name</td>
          <td><img src="@l.Logo" alt="Logo" style="max-width: 50px; max-height: 50px;" /></td>
          <td>
            <button class="btn btn-sm btn-primary me-1" @onclick="() => Edit(l.Id)" >Modifier</button>
            <button class="btn btn-sm btn-danger me-1" @onclick="() => ConfirmDelete(l.Id)">Supprimer</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}

@if (ShowDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Confirmation de suppression</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Êtes-vous sûr de vouloir supprimer cette ligue?
                        <br />
                        <strong>Cette action est irréversible.</strong>
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Annuler
                    </button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
  List<Ligue> ligues = new List<Ligue>();
  string ErrorMessage = string.Empty;

  private void SortById()
  {
      ligues = ligues.OrderBy(l => l.Id).ToList();
  }

  protected override async Task OnInitializedAsync()
    {
        try
        {
            ligues = await LigueService.GetAllAsync();
            SortById();
            Console.WriteLine("Ligues récupérés : " + ligues.Count);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard... " + e.Message;

        }
    }

    private int? LigueIdToDelete;
    private bool ShowDeleteModal = false;

    private void ConfirmDelete(int id)
    {
        LigueIdToDelete = id;
        ShowDeleteModal = true;
    }

    private async Task DeleteConfirmed()
    {
        if (LigueIdToDelete.HasValue)
        {
            await LigueService.DeleteAsync(LigueIdToDelete.Value);
            ligues = await LigueService.GetAllAsync();
        }

        ShowDeleteModal = false;
        LigueIdToDelete = null;
    }

    private void Add()
    {
        Navigation.NavigateTo("/ligues/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/ligues/edit/{id}");
    }
     private void CancelDelete()
    {
        ShowDeleteModal = false;
        LigueIdToDelete = null;
    }
}
