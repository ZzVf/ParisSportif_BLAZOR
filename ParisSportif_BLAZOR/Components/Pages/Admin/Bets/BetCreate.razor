@page "/admin/bets/create"
@using ParisSportif_BLAZOR.Model
@inject ParisSportif_BLAZOR.Services.BetService BetService
@inject ParisSportif_BLAZOR.Services.MatchService MatchService
@inject ParisSportif_BLAZOR.Services.ClientService ClientService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Ajouter un bet</h3>

<h2 style="color:red;">@ErrorMessage</h2>

<EditForm Model="@bet" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="client" class="form-label">Client</label>
        <InputSelect id="client" class="form-select" @bind-Value="bet.ClientId">
            <option value="">-- Sélectionnez un client --</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id">@client.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="match" class="form-label">Match</label>
        <InputSelect id="match" class="form-select" @bind-Value="bet.MatchId">
            <option value="">-- Sélectionnez un match --</option>
            @foreach (var match in matches)
            {
                <option value="@match.Id">@match.Club1?.Name vs @match.Club2?.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="match" class="form-label">Match</label>
        <InputSelect id="prediction" class="form-select" @bind-Value="bet.Prediction">
            <option value="">-- Sélectionnez une prédiction --</option>
            @foreach (var type in Enum.GetValues<BetPrediction>())
            {
                <option value="@type">@type</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="point" class="form-label">Point</label>
        <InputNumber id="point" class="form-control" @bind-Value="bet.Point" />
    </div>

    <button type="submit" class="btn btn-success">
        Enregistrer
    </button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Annuler
    </button>
</EditForm>

@code {
    private Bet bet = new Bet();
    private List<Match> matches = new List<Match>();
    private List<Client> clients = new List<Client>();
    string ErrorMessage="";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            matches = await MatchService.GetAllAsync();
            clients = await ClientService.GetAllAsync();
            Console.WriteLine("Matches récupérés : " + matches.Count);
            Console.WriteLine("Clients récupérés : " + clients.Count);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard..." + e.Message;
        }
    }
    private async Task HandleValidSubmit()
    {
        var selectedClient = clients.FirstOrDefault(c => c.Id == bet.ClientId);

        if (selectedClient == null)
        {
            ErrorMessage = "Client invalide.";
            return;
        }

        if (selectedClient.Points < bet.Point)
        {
            ErrorMessage = "Le client n'a pas assez de points pour faire ce pari.";
            return;
        }
        selectedClient.Points -= bet.Point;

        var result = await BetService.AddAsync(bet);

        if (result.Success)
        {
            await ClientService.UpdatePointsAsync(selectedClient.Id, selectedClient.Points);
            Navigation.NavigateTo("/admin/bets");
            Console.WriteLine("Bet créé avec succès : " + result.Data?.Id);
        }
        else
        {
            ErrorMessage = result.Error ?? "Erreur inconnue.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/bets");
    }
}