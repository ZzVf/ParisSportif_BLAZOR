@page "/admin/clubs/create"
@using ParisSportif_BLAZOR.Model
@using System.Runtime.InteropServices
@inject ParisSportif_BLAZOR.Services.ClubService ClubService
@inject ParisSportif_BLAZOR.Services.LigueService LigueService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Ajouter un club</h3>

<h2 style="color:red;">@ErrorMessage</h2>

<EditForm Model="@club" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nom</label>
        <InputText class="form-control" @bind-Value="club.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ligue</label>
        <InputSelect class="form-control" @bind-Value="club.LigueId">
            <option value="0">-- Choisir une ligue --</option>
            @foreach (var ligue in ligues)
            {
                <option value="@ligue.Id">@ligue.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Classement</label>
        <InputNumber class="form-control" @bind-Value="club.Ranking" />
    </div>

    <div class="mb-3">
        <label class="form-label">Logo</label>
        <InputFile class="form-control" OnChange="HandleFileSelected" />
        @if (!string.IsNullOrEmpty(club.Logo))
        {
            <div class="mt-2">
                <img src="@club.Logo" alt="Logo" style="max-width:200px; border:1px solid #ccc; padding:5px;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-success">
        Enregistrer
    </button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Annuler
    </button>
</EditForm>

@code {
    private Club club = new Club();
    private List<Ligue> ligues = new List<Ligue>();
    string ErrorMessage="";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ligues = await LigueService.GetAllAsync();
            Console.WriteLine("Ligues récupérées : " + ligues.Count);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard..." + e.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        var result = await ClubService.AddAsync(club);
        
        if (result.Success)
        {
            Navigation.NavigateTo("/admin/clubs");
            Console.WriteLine("Club créé avec succès : " + result.Data?.Id);
        }
        else
        {
            ErrorMessage = result.Error ?? "Erreur inconnue.";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;


        // Limite de taille
        var maxSize = 10_000_000;
        await using var stream = file.OpenReadStream(maxSize);
       
        // Générer un nom unique pour éviter les collisions
        var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";

        // Chemin complet côté serveur
        var savePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "clubs", fileName);

        // Copier le fichier dans wwwroot/images
        await using var fileStream = new FileStream(savePath, FileMode.Create);
        await stream.CopyToAsync(fileStream);

        // Mettre à jour le chemin relatif pour l'affichage
        club.Logo = $"images\\clubs\\{fileName}";

    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/clubs");
    }
}
