@page "/clubs"
@page "/clubslist"
@using ParisSportif_BLAZOR.Model
@using ParisSportif_BLAZOR.Services
@rendermode InteractiveServer
@inject ClubService ClubService
@inject NavigationManager Navigation

<div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOne">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
        <h3>Clubs</h3>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        <div class="row align-items-end">

            <div class="col-md-3">
            @if(string.IsNullOrWhiteSpace(ErrorMessage)) {
                <button class="btn btn-success btn-lg w-100" @onclick="Add">
                    Nouveau
                </button>
            }   

            </div>
        </div>
    </div>
    </div>
  </div>
</div>

<h2 style="color:red;">@ErrorMessage</h2>

@if(clubs == null || clubs.Count == 0)
{
    <p>Aucun club à afficher...</p>
}
else{
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">Logo</th>
        <th scope="col">Ranking</th>
        <th scope="col" @onclick="() => SortByLigueAndRanking()">LigueId</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
  
    <tbody>
      @foreach (var c in clubs)
      {
        <tr>
          <th scope="row">@c.Id</th>
          <td>@c.Name</td>
          <td><img src="@c.Logo" alt="Logo du club" width="50" height="50" /></td>
          <td>@c.Ranking</td>
          <td>@c.LigueId</td>
          <td>
            <button class="btn btn-sm btn-primary me-1" @onclick="() => Edit(c.Id)">Modifier</button>
            <button class="btn btn-sm btn-danger me-1" @onclick="() => ConfirmDelete(c.Id)">Supprimer</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}

@if (ShowDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Confirmation de suppression</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Êtes-vous sûr de vouloir supprimer ce club?
                        <br />
                        <strong>Cette action est irréversible.</strong>
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Annuler
                    </button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
  List<Club> clubs = new List<Club>();
  string ErrorMessage = string.Empty;

  private void SortByLigueAndRanking()
  {
      clubs = clubs.OrderBy(c => c.LigueId).ThenBy(c => c.Ranking).ToList();
  }

  private void SortById()
  {
      clubs = clubs.OrderBy(c => c.Id).ToList();
  }

  protected override async Task OnInitializedAsync()
    {
        try
        {
            clubs = await ClubService.GetAllAsync();
            SortById();
            Console.WriteLine("Clubs récupérés : " + clubs.Count);
        }
        catch (Exception e)
        {
            ErrorMessage = "Erreur d'accès à l'API, essayez de recharger la page plus tard... " + e.Message;

        }
    }

    private int? ClubIdToDelete;
    private bool ShowDeleteModal = false;

    private void ConfirmDelete(int id)
    {
        ClubIdToDelete = id;
        ShowDeleteModal = true;
    }

    private async Task DeleteConfirmed()
    {
        if (ClubIdToDelete.HasValue)
        {
            await ClubService.DeleteAsync(ClubIdToDelete.Value);
            clubs = await ClubService.GetAllAsync();
        }

        ShowDeleteModal = false;
        ClubIdToDelete = null;
    }

    private void Add()
    {
        Navigation.NavigateTo("/clubs/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/clubs/edit/{id}");
    }

    private void CancelDelete()
    {
        ShowDeleteModal = false;
        ClubIdToDelete = null;
    }
}
